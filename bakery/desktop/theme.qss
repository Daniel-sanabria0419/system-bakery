/* Tema visual del desktop — edita colores y tipografía aquí. */

QMainWindow,
QDialog{
    background-color: #F5F0E8;
    
}


QWidget#purchase_panel {
    background-color: #FFFFFF;
}

QFrame#entry_separator,
QFrame#total_separator {
    color: #000000;
    background-color: #000000;
    min-height: 2px;
    max-height: 2px;
}

QPushButton[class="pad-button"] {
    background-color: #D0D0D0;
    color:rgb(0, 0, 0);
    margin:  10px 3px;
    font-size: 28px;   
    font-weight: bold;
}

QPushButton[class="back-button"] {
    background-color: #5ac4f6;
    color: #FFFFFF;
    font-size: 30px;
    font-weight: bold;
    min-width: 72px;
    min-height: 20px;
    padding: 4px 8px;
}

QPushButton[class="menu-button"] {
    background-color: #2E7D32;
    color: #FFFFFF;
    padding: 12px 24px;
}

QPushButton[class="payment-button"] {
    background-color: #1A1A1A;
    color: #FFFFFF;
    padding: 12px;
}

QPushButton[class="payment-method-button"] {
    background-color: #1A1A1A;
    color: #FFFFFF;
    padding: 16px 20px;
    font-size: 18px;
}

QLabel[class="dialog-text"] {
    color: #1A1A1A;
    font-size: 28px;
    font-weight: bold;
}

QPushButton[class="dialog-action-button"] {
    background-color: #1A1A1A;
    color: #FFFFFF;
    font-size: 22px;
    padding: 12px 24px;
    min-height: 80px;
}

QLabel[class="money-text"] {
    color: #1A1A1A;
}

QLabel#sale_display[class="money-text"],
QLabel#purchase_total[class="money-text"] {
    font-size: 36px;
    font-weight: bold;
}

/* Solo líneas agregadas (etapa 3); no subir sale_display ni purchase_total. */
QLabel#purchase_list[class="money-text"] {
    font-size: 28px;
    font-weight: bold;
}


QLabel#purchase_list {
    background-color: #FFFFFF;
    color: #1A1A1A;   /* números oscuros sobre blanco */
}

QScrollArea#purchase_list_scroll > QWidget {
    background-color: #FFFFFF;
}
QScrollArea#purchase_list_scroll {
    background-color: #FFFFFF;
    border: none;
}

/* Catálogo venta Beta 2.0.1 — no reutilizar payment-method-button aquí. */
QWidget#future_panel,
QWidget#categories_list,
QWidget#sale_products_list,
QWidget#price_search_list,
QScrollArea#categories_scroll,
QScrollArea#sale_products_scroll,
QScrollArea#price_search_scroll,
QScrollArea#categories_scroll > QWidget,
QScrollArea#sale_products_scroll > QWidget,
QScrollArea#price_search_scroll > QWidget {
    background-color: #F5F0E8;
    color: #000000;
    border: none;
}

QPushButton[class="category-chip"],
QPushButton[class="product-chip"],
QToolButton[class="category-chip"],
QToolButton[class="product-chip"] {
    background-color: #64c466;
    color: #000000;
    font-size: 12px;
    font-weight: bold;
    padding: 4px;
    border: none;
}

QPushButton[class="category-chip-selected"],
QPushButton[class="product-chip-selected"],
QToolButton[class="category-chip-selected"],
QToolButton[class="product-chip-selected"] {
    background-color: #2E7D32;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: bold;
    padding: 4px;
    border: 2px solid #1B5E20;
}

QLabel#quantity_caption,
QLabel#quantity_label,
QLabel#quantity_value_label,
QLabel#sale_value_preview,
QLabel#selected_product_label,
QLabel#sale_feedback,
QLabel#price_search_caption,
QLabel#price_search_empty {
    color: #000000;
}

/* Formularios Crear / Editar producto — mismo lenguaje visual. */
QDialog#product_form_dialog {
    background-color: #F5F0E8;
}

QLineEdit[class="product-form-field"],
QComboBox[class="product-form-field"] {
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #C4B8A8;
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 18px;
    min-height: 40px;
    selection-background-color: #64c466;
    selection-color: #000000;
}

QLineEdit[class="product-form-field"] {
    placeholder-text-color: #5C5346;
}

QComboBox[class="product-form-field"]::drop-down {
    border: none;
    width: 28px;
}

QComboBox[class="product-form-field"] QAbstractItemView {
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #C4B8A8;
    selection-background-color: #64c466;
    selection-color: #000000;
    outline: 0;
}

QLabel[class="product-form-label"] {
    color: #000000;
    font-size: 16px;
    font-weight: normal;
}

QPushButton[class="product-form-button"] {
    background-color: #2E7D32;
    color: #FFFFFF;
    padding: 10px 16px;
    font-size: 16px;
    border: none;
    border-radius: 4px;
}