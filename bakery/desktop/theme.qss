/* Tema visual del desktop — edita colores y tipografía aquí.
 *
 * Tokens (Etapa 0 rediseño visual): placeholders COLOR / RADIUS / FONT
 * sustituidos desde style.py (load_theme_qss).
 * Menú (menu-button) y formularios producto (product-form-*) quedan con
 * valores fijos — no usar placeholders ahí.
 *
 * Reserva etapas 1+ (sin efecto visual aún): radio __RADIUS_BASE__px,
 * body __FONT_SIZE_BODY__px, title __FONT_SIZE_TITLE__px,
 * borde __COLOR_BORDER__.
 */

QMainWindow,
QDialog{
    background-color: __COLOR_PAGE_BG__;
    
}


/* Registrar venta (B) — paneles con radio/borde (Etapa 4). */
QWidget#register_sale_page {
    background-color: __COLOR_PAGE_BG__;
    color: __COLOR_TEXT_STRONG__;
}

QWidget#purchase_panel {
    background-color: __COLOR_SURFACE__;
    border: 1px solid __COLOR_BORDER__;
    border-radius: __RADIUS_BASE__px;
}

QFrame#total_separator {
    color: __COLOR_TEXT_STRONG__;
    background-color: __COLOR_TEXT_STRONG__;
    min-height: 2px;
    max-height: 2px;
}

QPushButton[class="back-button"] {
    background-color: __COLOR_ACCENT_CYAN__;
    color: __COLOR_TEXT_ON_DARK__;
    font-size: 30px;
    font-weight: bold;
    min-width: 72px;
    /* Alineado a BACK_BUTTON_MIN_HEIGHT (style.py); border:none no debe bajarlo. */
    min-height: 29px;
    padding: 4px 8px;
    border: none;
    border-radius: __RADIUS_BASE__px;
}

QPushButton[class="back-button"]:pressed {
    background-color: __COLOR_ACCENT_CYAN_PRESSED__;
}

QPushButton[class="back-button"]:disabled {
    background-color: __COLOR_DISABLED_BG__;
    color: __COLOR_DISABLED_TEXT__;
}

/* Menú principal — INTACTO (no tokens / no :pressed aquí). */
QPushButton[class="menu-button"] {
    background-color: #2E7D32;
    color: #FFFFFF;
    padding: 12px 24px;
}

QPushButton[class="payment-button"] {
    background-color: __COLOR_PAYMENT_IDLE__;
    color: __COLOR_TEXT_ON_DARK__;
    padding: 12px;
    font-size: 18px;
    font-weight: bold;
    border: none;
    border-radius: __RADIUS_BASE__px;
}

QPushButton[class="payment-button"]:pressed {
    background-color: __COLOR_PAYMENT_IDLE_PRESSED__;
}

QPushButton[class="payment-button"]:disabled {
    background-color: __COLOR_DISABLED_BG__;
    color: __COLOR_DISABLED_TEXT__;
}

/* Acciones cobro 2.0.6 — colores desde style.py (load_theme_qss). */
QPushButton[class="pagar-button"] {
    background-color: __PAGAR_BUTTON_COLOR__;
    color: __COLOR_TEXT_ON_DARK__;
    padding: 12px;
    font-size: 20px;
    font-weight: bold;
    border: none;
    border-radius: __RADIUS_BASE__px;
}

QPushButton[class="pagar-button"]:pressed {
    background-color: __COLOR_ACCENT_CYAN_PRESSED__;
}

QPushButton[class="pagar-button"]:disabled {
    background-color: __COLOR_DISABLED_BG__;
    color: __COLOR_DISABLED_TEXT__;
}

QPushButton[class="borrar-todo-button"] {
    background-color: __BORRAR_TODO_BUTTON_COLOR__;
    color: __COLOR_TEXT_ON_DARK__;
    padding: 12px;
    font-size: 18px;
    font-weight: bold;
    border: none;
    border-radius: __RADIUS_BASE__px;
}

QPushButton[class="borrar-todo-button"]:pressed {
    background-color: __COLOR_DESTRUCTIVE_PRESSED__;
}

QPushButton[class="borrar-todo-button"]:disabled {
    background-color: __COLOR_DISABLED_BG__;
    color: __COLOR_DISABLED_TEXT__;
}

QPushButton[class="payment-method-button"] {
    background-color: __COLOR_BUTTON_DARK__;
    color: __COLOR_TEXT_ON_DARK__;
    padding: 16px 20px;
    font-size: 18px;
}

QPushButton[class="payment-method-button"]:pressed {
    background-color: __COLOR_BUTTON_DARK_PRESSED__;
}

QPushButton[class="payment-method-button"]:disabled {
    background-color: __COLOR_DISABLED_BG__;
    color: __COLOR_DISABLED_TEXT__;
}

QWidget#sale_actions_panel {
    background-color: transparent;
}

/* ± cantidad y X de fila en cobro: gris secundario (no negro payment-method). */
QPushButton[class="qty-adjust-button"],
QPushButton[class="purchase-row-delete-button"] {
    background-color: __COLOR_BUTTON_SECONDARY__;
    color: __COLOR_TEXT_ON_DARK__;
    padding: 8px 12px;
    font-size: 18px;
    font-weight: bold;
    border: none;
    border-radius: __RADIUS_BASE__px;
}

QPushButton[class="qty-adjust-button"]:pressed,
QPushButton[class="purchase-row-delete-button"]:pressed {
    background-color: __COLOR_BUTTON_SECONDARY_PRESSED__;
}

QPushButton[class="qty-adjust-button"]:disabled,
QPushButton[class="purchase-row-delete-button"]:disabled {
    background-color: __COLOR_DISABLED_BG__;
    color: __COLOR_DISABLED_TEXT__;
}

/* Listado Productos (CRUD) — fondo blanco; no tocar payment-method-button. */
QWidget#products_page,
QWidget#products_list,
QScrollArea#products_list_scroll,
QScrollArea#products_list_scroll > QWidget {
    background-color: __COLOR_SURFACE__;
    color: __COLOR_TEXT_STRONG__;
    border: none;
}

/* Etapa 1: resumen de fila legible (texto oscuro sobre blanco). */
QLabel[class="products-row-summary"] {
    color: __COLOR_TEXT_STRONG__;
    font-size: __FONT_SIZE_BODY__px;
    background-color: transparent;
}

/* Toolbar «Nuevo producto»: verde propio (no acoplar a menu-button). */
QPushButton[class="products-toolbar-button"] {
    background-color: #2E7D32;
    color: #FFFFFF;
    padding: 12px 24px;
    font-size: __FONT_SIZE_BODY__px;
    font-weight: bold;
    border: none;
    border-radius: __RADIUS_BASE__px;
}

QPushButton[class="products-toolbar-button"]:pressed {
    background-color: __COLOR_ACCENT_GREEN_PRESSED__;
}

QPushButton[class="products-toolbar-button"]:disabled {
    background-color: __COLOR_DISABLED_BG__;
    color: __COLOR_DISABLED_TEXT__;
}

/* Editar / Activar|Desactivar: gris secundario táctil (no negro de cobro). */
QPushButton[class="products-row-button"] {
    background-color: __COLOR_BUTTON_SECONDARY__;
    color: __COLOR_TEXT_ON_DARK__;
    padding: 12px 16px;
    font-size: __FONT_SIZE_BODY__px;
    font-weight: bold;
    border: none;
    border-radius: __RADIUS_BASE__px;
}

QPushButton[class="products-row-button"]:pressed {
    background-color: __COLOR_BUTTON_SECONDARY_PRESSED__;
}

QPushButton[class="products-row-button"]:disabled {
    background-color: __COLOR_DISABLED_BG__;
    color: __COLOR_DISABLED_TEXT__;
}

/* Historial listado (E) — crema + filas blancas; no reusar payment-method-button. */
QWidget#historial_page,
QWidget#historial_list_page,
QWidget#historial_list,
QScrollArea#historial_list_scroll,
QScrollArea#historial_list_scroll > QWidget {
    background-color: __COLOR_PAGE_BG__;
    color: __COLOR_TEXT_STRONG__;
    border: none;
}

QLabel#historial_empty[class="historial-empty-text"],
QLabel[class="historial-empty-text"] {
    color: __COLOR_TEXT__;
    font-size: __FONT_SIZE_BODY__px;
    background-color: transparent;
    padding: 12px 4px;
}

QPushButton[class="historial-row-button"] {
    background-color: __COLOR_SURFACE__;
    color: __COLOR_TEXT_STRONG__;
    padding: 12px 16px 12px 12px;
    font-size: __FONT_SIZE_BODY__px;
    font-weight: bold;
    text-align: left;
    border: 1px solid __COLOR_BORDER__;
    border-radius: __RADIUS_BASE__px;
}

QPushButton[class="historial-row-button"]:pressed {
    background-color: __COLOR_BORDER__;
    color: __COLOR_TEXT_STRONG__;
}

QPushButton[class="historial-row-button"]:disabled {
    background-color: __COLOR_DISABLED_BG__;
    color: __COLOR_DISABLED_TEXT__;
}

/* Historial detalle (F) — crema + paneles blancos; sin inline font-weight. */
QWidget#historial_detail_page,
QWidget#historial_detail_content,
QScrollArea#historial_detail_scroll,
QScrollArea#historial_detail_scroll > QWidget {
    background-color: __COLOR_PAGE_BG__;
    color: __COLOR_TEXT_STRONG__;
    border: none;
}

QLabel#historial_detail_title[class="historial-detail-page-title"],
QLabel[class="historial-detail-page-title"] {
    color: __COLOR_TEXT_STRONG__;
    font-size: __FONT_SIZE_TITLE__px;
    font-weight: bold;
    background-color: transparent;
}

QWidget[class="historial-section"] {
    background-color: __COLOR_SURFACE__;
    color: __COLOR_TEXT_STRONG__;
    border: 1px solid __COLOR_BORDER__;
    border-radius: __RADIUS_BASE__px;
}

QLabel[class="historial-section-title"] {
    color: __COLOR_TEXT_STRONG__;
    font-size: __FONT_SIZE_TITLE__px;
    font-weight: bold;
    background-color: transparent;
}

QLabel[class="historial-detail-meta"] {
    color: __COLOR_TEXT__;
    font-size: __FONT_SIZE_BODY__px;
    background-color: transparent;
}

QLabel[class="historial-detail-total"] {
    color: __COLOR_TEXT_STRONG__;
    font-size: __FONT_SIZE_TITLE__px;
    font-weight: bold;
    background-color: transparent;
}

QLabel[class="historial-detail-body"] {
    color: __COLOR_TEXT__;
    font-size: __FONT_SIZE_BODY__px;
    background-color: transparent;
}

QPushButton[class="historial-detail-primary-button"] {
    background-color: #2E7D32;
    color: #FFFFFF;
    padding: 12px 24px;
    font-size: __FONT_SIZE_BODY__px;
    font-weight: bold;
    border: none;
    border-radius: __RADIUS_BASE__px;
}

QPushButton[class="historial-detail-primary-button"]:pressed {
    background-color: __COLOR_ACCENT_GREEN_PRESSED__;
}

QPushButton[class="historial-detail-primary-button"]:disabled {
    background-color: __COLOR_DISABLED_BG__;
    color: __COLOR_DISABLED_TEXT__;
}

QPushButton[class="historial-detail-secondary-button"] {
    background-color: __COLOR_BUTTON_SECONDARY__;
    color: __COLOR_TEXT_ON_DARK__;
    padding: 12px 24px;
    font-size: __FONT_SIZE_BODY__px;
    font-weight: bold;
    border: none;
    border-radius: __RADIUS_BASE__px;
}

QPushButton[class="historial-detail-secondary-button"]:pressed {
    background-color: __COLOR_BUTTON_SECONDARY_PRESSED__;
}

QPushButton[class="historial-detail-secondary-button"]:disabled {
    background-color: __COLOR_DISABLED_BG__;
    color: __COLOR_DISABLED_TEXT__;
}

QLabel[class="dialog-text"] {
    color: __COLOR_TEXT__;
    font-size: 28px;
    font-weight: bold;
}

QPushButton[class="dialog-action-button"] {
    background-color: __COLOR_BUTTON_DARK__;
    color: __COLOR_TEXT_ON_DARK__;
    font-size: 22px;
    padding: 12px 24px;
    min-height: 80px;
}

QPushButton[class="dialog-action-button"]:pressed {
    background-color: __COLOR_BUTTON_DARK_PRESSED__;
}

QPushButton[class="dialog-action-button"]:disabled {
    background-color: __COLOR_DISABLED_BG__;
    color: __COLOR_DISABLED_TEXT__;
}

QLabel[class="money-text"] {
    color: __COLOR_TEXT__;
}

/* Footer Subtotal / Descuento / Total (Beta 2.0.6). */
QLabel#purchase_subtotal[class="money-text"],
QLabel#purchase_discount[class="money-text"],
QLabel#purchase_total[class="money-text"] {
    font-size: __FOOTER_TOTALS_FONT_SIZE__px;
    font-weight: bold;
}

QLabel#purchase_total[class="money-text"] {
    font-size: 28px;
}

/* Filas de la tabla de compra. */
QWidget#purchase_list {
    background-color: __COLOR_SURFACE__;
    color: __COLOR_TEXT__;
}

QScrollArea#purchase_list_scroll > QWidget {
    background-color: __COLOR_SURFACE__;
}
QScrollArea#purchase_list_scroll {
    background-color: __COLOR_SURFACE__;
    border: none;
}

QWidget#purchase_table_header QLabel {
    color: __COLOR_TEXT__;
    font-size: 14px;
    font-weight: bold;
}

/* Catálogo venta Beta 2.0.2 — secciones #d7d4ce; no payment-method-button. */
QWidget#future_panel {
    background-color: __COLOR_PAGE_BG__;
    color: __COLOR_TEXT_STRONG__;
    border: none;
}

QWidget#catalog_categories_section,
QWidget#catalog_products_section,
QWidget#categories_list,
QWidget#sale_products_list,
QScrollArea#categories_scroll,
QScrollArea#sale_products_scroll,
QScrollArea#categories_scroll > QWidget,
QScrollArea#sale_products_scroll > QWidget {
    background-color: #d7d4ce;
    color: __COLOR_TEXT_STRONG__;
    border: none;
}

QFrame#catalog_sections_divider {
    color: __COLOR_TEXT_STRONG__;
    background-color: __COLOR_TEXT_STRONG__;
    min-height: 2px;
    max-height: 2px;
}

QLabel#categories_caption,
QLabel#products_caption {
    color: __COLOR_TEXT_STRONG__;
}

/* Tipografía: placeholders sustituidos desde style.py (load_theme_qss).
   Chips son QToolButton (CatalogChipButton); no hay QPushButton chip. */
QToolButton[class="category-chip"] {
    background-color: __COLOR_CHIP__;
    color: __COLOR_TEXT_STRONG__;
    font-size: __CATEGORY_CHIP_FONT_SIZE__px;
    font-weight: bold;
    padding: 4px;
    border: none;
}

QToolButton[class="product-chip"] {
    background-color: __COLOR_CHIP__;
    color: __COLOR_TEXT_STRONG__;
    font-size: __PRODUCT_CHIP_FONT_SIZE__px;
    font-weight: bold;
    padding: 4px;
    border: none;
}

QToolButton[class="category-chip"]:pressed,
QToolButton[class="product-chip"]:pressed {
    background-color: __COLOR_CHIP_PRESSED__;
}

QToolButton[class="category-chip"]:disabled,
QToolButton[class="product-chip"]:disabled {
    background-color: __COLOR_DISABLED_BG__;
    color: __COLOR_DISABLED_TEXT__;
}

QToolButton[class="category-chip-selected"] {
    background-color: #2E7D32;
    color: #FFFFFF;
    font-size: __CATEGORY_CHIP_FONT_SIZE__px;
    font-weight: bold;
    padding: 4px;
    border: 2px solid #1B5E20;
}

QToolButton[class="product-chip-selected"] {
    background-color: #2E7D32;
    color: #FFFFFF;
    font-size: __PRODUCT_CHIP_FONT_SIZE__px;
    font-weight: bold;
    padding: 4px;
    border: 2px solid #1B5E20;
}

QToolButton[class="category-chip-selected"]:pressed,
QToolButton[class="product-chip-selected"]:pressed {
    background-color: __COLOR_CHIP_SELECTED_PRESSED__;
}

QWidget#selected_product_panel {
    background-color: __COLOR_SURFACE__;
    border: 1px solid __COLOR_BORDER__;
    border-radius: __RADIUS_BASE__px;
}

QWidget#quantity_section {
    background-color: transparent;
}

QLabel#quantity_label,
QLabel#quantity_value_label,
QLabel#selected_product_unit_price,
QLabel#sale_value_preview,
QLabel#selected_product_label,
QLabel#selected_product_image,
QLabel#sale_feedback {
    color: __COLOR_TEXT_STRONG__;
}


/* Formularios Crear / Editar producto — mismo lenguaje visual.
 * INTACTO en Etapa 0: valores fijos (no placeholders de tokens). */
QDialog#product_form_dialog {
    background-color: #F5F0E8;
}

QLineEdit[class="product-form-field"],
QComboBox[class="product-form-field"] {
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #C4B8A8;
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 18px;
    min-height: 40px;
    selection-background-color: #64c466;
    selection-color: #000000;
}

QLineEdit[class="product-form-field"] {
    placeholder-text-color: #5C5346;
}

QComboBox[class="product-form-field"]::drop-down {
    border: none;
    width: 28px;
}

QComboBox[class="product-form-field"] QAbstractItemView {
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #C4B8A8;
    selection-background-color: #64c466;
    selection-color: #000000;
    outline: 0;
}

QLabel[class="product-form-label"] {
    color: #000000;
    font-size: 16px;
    font-weight: normal;
}

QPushButton[class="product-form-button"] {
    background-color: #2E7D32;
    color: #FFFFFF;
    padding: 10px 16px;
    font-size: 16px;
    border: none;
    border-radius: 4px;
}
